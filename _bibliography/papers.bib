@inproceedings{kim2026bridging,
  abbr={IROS SRW},
  bibtex_show={true},
  title={Bridging the Scale Gap: Cross-View Localization from Dense Rover LiDAR to Coarse Lunar DEMs},
  author={Kim*, Seongwon and Song*, Minseok and Yang, Seonmo and Chatterjee, Soumyadeep and Soussan, Ryan and Lee†, Seokju and Kim†, Pyojin},
  booktitle={IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS) Space Robotics Workshop},
  year={2026},
  month={sep},
  note={Selected for Oral Presentation · Best Oral Presentation Award},
  annotation={* Equal contribution<br>† Corresponding authors},
  award={**Best Oral Presentation Award** at the IROS 2026 Space Robotics Workshop (selected for oral presentation).},
  award_name={Best Oral Presentation Award},
  abstract={Rovers on the Moon must recover their absolute pose without GNSS, and orbital Digital Elevation Models (DEMs) are, in practice, the primary globally available geometric prior before landing. Matching onboard LiDAR against an orbital DEM offers an absolute, illumination-invariant position fix, yet to our knowledge, existing methods have not been evaluated in this lunar cross-view setting using real orbital topography. We benchmark four representative geometric and learning-based methods—DARCES, BEVPlace++, RING, and ICP—on a simulated lunar dataset built from real orbital DEMs of five sites, using single-frame LiDAR queries without odometry across a DEM-resolution sweep from 0.25 to 10 m/pixel. Meaningful localization is achieved only on sites with distinctive and spatially unique terrain structure, and with relatively fine DEMs; performance remains poor on feature-poor mare terrain regardless of resolution and degrades sharply at the coarser resolutions that cover most of the lunar surface. These findings identify two key bottlenecks for globally applicable lunar cross-view localization: robustness to coarse DEM resolution and robustness to feature-poor terrain.},
